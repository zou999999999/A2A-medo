# Host Headset Configuration (.env.example)
HOST_AID=
HOST_NAME=Personal-Host-Headset
PORT=3100
PUBLIC_HTTPS_URL=
PRIVATE_CHAIN_URL=https://a2a-medo.vercel.app
# Shared secret with Vercel Private Chain for /chain-anchor/ledger (or stored locally in server/data/anchor_secrets.json)
ANCHOR_SECRET=
# Optional fixed local control token for /host/* (auto-generated in server/data/local_control_token if omitted)
HOST_LOCAL_TOKEN=
AUTO_REPLY_ENABLED=false
