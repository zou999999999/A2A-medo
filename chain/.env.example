# Private Chain Anchor & Governance Configuration (.env.example)
# Configure all three variables in Vercel Dashboard -> Project Settings -> Environment Variables:
#   1. ANCHOR_HOST_URL  : Your Anchor Host PC's permanent HTTPS endpoint
#   2. ANCHOR_SECRET    : Shared secret matching server/data/anchor_secrets.json on your Anchor Host PC
#   3. CHAIN_ADMIN_KEY  : Administrator secret required to modify Genesis AID = 1
ANCHOR_HOST_URL=
ANCHOR_SECRET=
CHAIN_ADMIN_KEY=
